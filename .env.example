# Copy to .env and fill in your own key. Never commit .env.

# https://www.alphavantage.co/support/#api-key (free tier -- 25 requests/day)
ALPHA_VANTAGE_API_KEY=

# https://finnhub.io/register (free tier -- 60 requests/minute, no daily
# cap) -- primary source for fundamentals (P/E, company profile); Alpha
# Vantage OVERVIEW above is kept as a fallback/description-source, see
# ingest/fundamentals.py.
FINNHUB_API_KEY=

# Optional: a Discord (or Slack, using its Discord-compatible webhook
# format) webhook URL for recommendation-change alerts. Leave blank to
# disable alerts entirely.
DISCORD_WEBHOOK_URL=
